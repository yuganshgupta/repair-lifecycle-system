@page "/technician/complaints"
@attribute [Authorize(Roles = "Technician")]
@rendermode InteractiveServer

@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using RepairSystem.Web.Features.Dashboard.Contracts
@using RepairSystem.Web.Services.Authentication

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IApiTokenSessionStore TokenStore

<MudProviders />

<PageTitle>My Assigned Repairs</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-2 mb-4">
        <div>
            <h1 class="mb-1">My Assigned Repairs</h1>
            <p class="text-muted mb-0">
                Review repair requests assigned to your account.
            </p>
        </div>

        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       OnClick="LoadComplaintsAsync"
                       Disabled="@_isLoading">
                Refresh
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       Href="/dashboard">
                Dashboard
            </MudButton>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="card">
            <div class="card-body text-center p-5">
                <MudProgressCircular Color="Color.Primary"
                                     Indeterminate="true" />
                <p class="text-muted mt-3 mb-0">
                    Loading your assigned repairs...
                </p>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between">
            <span>@_error</span>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       Class="ms-2"
                       OnClick="LoadComplaintsAsync">
                Retry
            </MudButton>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Total assigned</div>
                        <h2 class="mb-0">@_complaints.Count</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">In progress</div>
                        <h2 class="mb-0">
                            @_complaints.Count(c =>
                                c.Status != "Completed" &&
                                c.Status != "Cancelled")
                        </h2>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Completed</div>
                        <h2 class="mb-0">
                            @_complaints.Count(c => c.Status == "Completed")
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        @if (_complaints.Count == 0)
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <h2 class="h5">No repairs assigned yet</h2>
                    <p class="text-muted mb-0">
                        Repair requests assigned to you by an Admin
                        will appear here.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var complaint in _complaints
                    .OrderByDescending(c => c.CreatedAt))
                {
                    <div class="col-12" @key="complaint.ComplaintId">
                        <div class="card">
                            <div class="card-header bg-white d-flex
                                flex-wrap justify-content-between
                                align-items-center gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <strong>@complaint.TicketNumber</strong>
                                    <MudChip T="string"
                                             Size="Size.Small"
                                             Color="@GetStatusColor(complaint.Status)">
                                        @FormatStatus(complaint.Status)
                                    </MudChip>
                                </div>

                                <small class="text-muted">
                                    Submitted
                                    @(complaint.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                                </small>
                            </div>

                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Customer
                                        </div>
                                        <div class="fw-semibold">
                                            @complaint.CustomerName
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Device
                                        </div>
                                        <div class="fw-semibold">
                                            @complaint.DeviceBrand
                                            @complaint.DeviceModel
                                        </div>
                                        <div class="small text-muted">
                                            @complaint.DeviceType
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="text-muted small">
                                            Serial number
                                        </div>
                                        <div>
                                            @(string.IsNullOrWhiteSpace(
                                                complaint.SerialNumber)
                                                ? "Not provided"
                                                : complaint.SerialNumber)
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <hr />
                                        <div class="text-muted small mb-1">
                                            Reported issue
                                        </div>
                                        <p class="mb-0">
                                            @complaint.IssueDescription
                                        </p>
                                    </div>

                                    @if (complaint.ClaimedWarranty)
                                    {
                                        <div class="col-12">
                                            <MudChip T="string"
                                                     Size="Size.Small"
                                                     Color="Color.Info"
                                                     Variant="Variant.Outlined">
                                                Warranty claimed
                                            </MudChip>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<TechnicianComplaintApiDto> _complaints = [];

    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadComplaintsAsync();
    }

    private async Task LoadComplaintsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            var token = await GetAccessTokenAsync();

            if (token is null)
                return;

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                "api/technician/complaints");

            request.Headers.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            using var response = await client.SendAsync(request);

            if (!response.IsSuccessStatusCode)
            {
                _error = await GetResponseErrorAsync(response);
                return;
            }

            _complaints = await response.Content
                .ReadFromJsonAsync<List<TechnicianComplaintApiDto>>() ?? [];
        }
        catch (HttpRequestException)
        {
            _error = "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _error = "The API request timed out. Please try again.";
        }
        catch (JsonException)
        {
            _error = "The API returned an invalid complaints response.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task<string?> GetAccessTokenAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var sessionId = authState.User
            .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
            ?.Value;

        if (string.IsNullOrWhiteSpace(sessionId) ||
            !TokenStore.TryGet(sessionId, out var session) ||
            session is null)
        {
            _error = "Your session is unavailable. Please sign in again.";
            return null;
        }

        if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
        {
            _error = "Your API token has expired. Please sign in again.";
            return null;
        }

        return session.AccessToken;
    }

    private static async Task<string> GetResponseErrorAsync(
        HttpResponseMessage response)
    {
        var body = await response.Content.ReadAsStringAsync();

        if (!string.IsNullOrWhiteSpace(body))
        {
            try
            {
                using var document = JsonDocument.Parse(body);

                if (document.RootElement.TryGetProperty(
                        "message",
                        out var message))
                {
                    return message.GetString()
                        ?? "The API rejected the request.";
                }
            }
            catch (JsonException)
            {
                // Use the status-code fallback below.
            }
        }

        return response.StatusCode switch
        {
            HttpStatusCode.Unauthorized =>
                "Your API session has expired. Please sign in again.",

            HttpStatusCode.Forbidden =>
                "The API denied access. A Technician role is required.",

            _ =>
                $"Could not load assigned repairs. API returned " +
                $"HTTP {(int)response.StatusCode}."
        };
    }

    private static string FormatStatus(string status)
    {
        return status switch
        {
            "QuotePending" => "Quote Pending",
            "InDiagnosis" => "In Diagnosis",
            "InRepair" => "In Repair",
            _ => status
        };
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Completed" => Color.Success,
            "Cancelled" => Color.Error,
            "InRepair" => Color.Primary,
            "InDiagnosis" => Color.Info,
            "QuotePending" => Color.Warning,
            "Assigned" => Color.Primary,
            _ => Color.Default
        };
    }
}