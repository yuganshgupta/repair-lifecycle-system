@page "/dashboard"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using System.Threading
@using RepairSystem.Web.Features.Dashboard.Contracts
@using Microsoft.AspNetCore.Components.Forms

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IApiTokenSessionStore TokenStore

<MudProviders />

<PageTitle>Dashboard</PageTitle>

<div class="rl-dashboard">
    <div class="container">
        <AuthorizeView>
            <Authorized Context="authState">
                <header class="rl-dashboard-header">
                    <div class="rl-dashboard-header-main">
                        <div>
                            <h1>Dashboard</h1>
                            <p class="rl-dashboard-subtitle">
                                Welcome, @authState.User.Identity?.Name.
                            </p>
                        </div>

                        <div class="rl-dashboard-header-actions">

                            <span class="rl-dashboard-role-badge">
                                @(authState.User.FindFirst(
                                    System.Security.Claims.ClaimTypes.Role)?.Value)
                            </span>

                            <form method="post"
                                  action="/auth/logout"
                                  class="m-0">

                                <AntiforgeryToken />

                                <button type="submit"
                                        class="btn btn-outline-secondary rl-dashboard-signout">
                                    <i class="bi bi-box-arrow-right me-1"
                                       aria-hidden="true"></i>
                                    Sign out
                                </button>

                            </form>

                        </div>
                    </div>
                </header>

                @if (authState.User.IsInRole("Customer"))
                {
                    <section class="rl-dashboard-section">

                        <div class="rl-dashboard-section-header">
                            <div>
                                <h2>My Repair Requests</h2>
                                <p>
                                    Track the progress of your submitted repair requests.
                                </p>
                            </div>

                            <div class="rl-dashboard-actions">
                                <button type="button"
                                        class="btn btn-primary"
                                        @onclick="OpenComplaintForm">
                                    <i class="bi bi-plus-lg me-1"></i>
                                    New Repair Request
                                </button>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_complaintSuccessMessage))
                        {
                            <div class="alert alert-success mb-4" role="alert">
                                @_complaintSuccessMessage
                            </div>
                        }

                        @if (_showComplaintForm)
                        {
                            <div class="card rl-dashboard-card mb-4">
                                <div class="card-header rl-dashboard-card-header">
                                    <h3>Submit a Repair Request</h3>
                                </div>

                                <div class="card-body rl-dashboard-card-body">

                                    @if (!string.IsNullOrWhiteSpace(_complaintFormError))
                                    {
                                        <div class="alert alert-danger">
                                            @_complaintFormError
                                        </div>
                                    }

                                    <EditForm Model="@_newComplaint"
                                              OnValidSubmit="SubmitComplaintAsync">

                                        <DataAnnotationsValidator />
                                        <ValidationSummary />

                                        <div class="row g-3">

                                            <div class="col-md-6">
                                                <label class="form-label">Device Type</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_newComplaint.DeviceType"
                                                           placeholder="e.g. Laptop" />
                                                <ValidationMessage For="@(() => _newComplaint.DeviceType)" />
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Brand</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_newComplaint.DeviceBrand"
                                                           placeholder="e.g. Dell" />
                                                <ValidationMessage For="@(() => _newComplaint.DeviceBrand)" />
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">Model</label>
                                                <InputText class="form-control"
                                                           @bind-Value="_newComplaint.DeviceModel"
                                                           placeholder="e.g. Inspiron 15" />
                                                <ValidationMessage For="@(() => _newComplaint.DeviceModel)" />
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label">
                                                    Serial Number (Optional)
                                                </label>
                                                <InputText class="form-control"
                                                           @bind-Value="_newComplaint.SerialNumber"
                                                           placeholder="Enter serial number" />
                                                <ValidationMessage For="@(() => _newComplaint.SerialNumber)" />
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label">Describe the Issue</label>
                                                <InputTextArea class="form-control"
                                                               rows="4"
                                                               @bind-Value="_newComplaint.IssueDescription"
                                                               placeholder="Describe the problem with your device..." />
                                                <ValidationMessage For="@(() => _newComplaint.IssueDescription)" />
                                            </div>

                                            <div class="col-12">
                                                <div class="form-check">
                                                    <InputCheckbox id="claimedWarranty"
                                                                   class="form-check-input"
                                                                   @bind-Value="_newComplaint.ClaimedWarranty" />

                                                    <label class="form-check-label"
                                                           for="claimedWarranty">
                                                        This device is covered under warranty.
                                                    </label>
                                                </div>
                                            </div>

                                            <div class="col-12 rl-dashboard-actions">
                                                <button type="submit"
                                                        class="btn btn-primary"
                                                        disabled="@_isSubmittingComplaint">

                                                    @if (_isSubmittingComplaint)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                        <span>Submitting...</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Submit Request</span>
                                                    }
                                                </button>

                                                <button type="button"
                                                        class="btn btn-outline-secondary"
                                                        @onclick="CancelComplaintForm"
                                                        disabled="@_isSubmittingComplaint">
                                                    Cancel
                                                </button>
                                            </div>

                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        }

                        @if (_isLoadingComplaints)
                        {
                            <div class="card rl-dashboard-card">
                                <div class="card-body rl-dashboard-empty">
                                    <div class="spinner-border text-primary"
                                         role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="text-muted mt-3 mb-0">
                                        Loading your repair requests...
                                    </p>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_complaintsError))
                        {
                            <div class="alert alert-danger" role="alert">
                                @_complaintsError
                            </div>
                        }
                        else
                        {
                            <div class="row g-3 mb-4">

                                <div class="col-md-4">
                                    <div class="card rl-dashboard-card rl-dashboard-stat-card h-100">
                                        <div class="card-body rl-dashboard-card-body">
                                            <p class="rl-dashboard-stat-label">Open Repairs</p>
                                            <h3 class="rl-dashboard-stat-value">
                                                @_customerComplaints.Count(c =>
                                                    c.Status != "Completed" &&
                                                    c.Status != "Cancelled")
                                            </h3>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rl-dashboard-card rl-dashboard-stat-card h-100">
                                        <div class="card-body rl-dashboard-card-body">
                                            <p class="rl-dashboard-stat-label">
                                                Awaiting Quote
                                            </p>
                                            <h3 class="rl-dashboard-stat-value">
                                                @_customerComplaints.Count(c =>
                                                    c.Status == "QuotePending")
                                            </h3>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="card rl-dashboard-card rl-dashboard-stat-card h-100">
                                        <div class="card-body rl-dashboard-card-body">
                                            <p class="rl-dashboard-stat-label">
                                                Completed Repairs
                                            </p>
                                            <h3 class="rl-dashboard-stat-value">
                                                @_customerComplaints.Count(c =>
                                                    c.Status == "Completed")
                                            </h3>
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="card rl-dashboard-card">
                                <div class="card-header rl-dashboard-card-header">
                                    <h3>Repair History</h3>
                                </div>

                                @if (_customerComplaints.Count == 0)
                                {
                                    <div class="card-body rl-dashboard-empty">
                                        <h4>No repair requests yet</h4>

                                        <p>
                                            Your submitted repair requests will appear here.
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 rl-dashboard-table">
                                            <thead>
                                                <tr>
                                                    <th>Ticket Number</th>
                                                    <th>Device</th>
                                                    <th>Issue</th>
                                                    <th>Submitted</th>
                                                    <th>Status</th>
                                                    <th>History</th>
                                                </tr>
                                            </thead>

                                            <tbody>
                                                @foreach (var complaint in _customerComplaints
                                                    .OrderByDescending(c => c.CreatedAt))
                                                {
                                                    var isExpanded = _selectedHistoryComplaintId == complaint.ComplaintId;

                                                    <tr class="@(isExpanded ? "rl-history-row-active" : null)">
                                                        <td>
                                                            <strong>
                                                                @complaint.TicketNumber
                                                            </strong>
                                                        </td>

                                                        <td>
                                                            <div class="rl-dashboard-device-name">
                                                                @GetDeviceName(complaint)
                                                            </div>
                                                            <small class="text-muted">
                                                                @complaint.DeviceType
                                                            </small>
                                                        </td>

                                                        <td>
                                                            @complaint.IssueDescription
                                                        </td>

                                                        <td>
                                                            @complaint.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                                        </td>

                                                        <td>
                                                            <span class="badge rl-dashboard-status-badge @GetStatusBadgeClass(complaint.Status)">
                                                                @FormatStatus(complaint.Status)
                                                            </span>
                                                        </td>

                                                        <td>
                                                            <button type="button"
                                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center justify-content-center rl-history-toggle"
                                                                    aria-expanded="@isExpanded"
                                                                    aria-label="@(isExpanded ? "Hide complaint history" : "Show complaint history")"
                                                                    title="@(isExpanded ? "Hide history" : "Show history")"
                                                                    @onclick="() => ToggleComplaintHistoryAsync(complaint)">
                                                                <span class="rl-chevron-icon @(isExpanded ? "is-expanded" : null)">
                                                                    <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" />
                                                                </span>
                                                            </button>
                                                        </td>
                                                    </tr>

                                                    <tr class="rl-history-detail-row">
                                                        <td colspan="6">
                                                            <div class="rl-history-drawer @(isExpanded ? "is-open" : null)"
                                                                 aria-hidden="@(!isExpanded)">

                                                                <div class="rl-history-drawer-inner">
                                                                    <div class="card-body border-top">

                                                                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                                                            <div>
                                                                                <h4 class="h5 mb-1">Repair Timeline</h4>
                                                                                <p class="text-muted mb-0">
                                                                                    Ticket: @complaint.TicketNumber
                                                                                </p>
                                                                            </div>
                                                                        </div>

                                                                        @if (isExpanded)
                                                                        {
                                                                            @if (_showComplaintHistorySpinner)
                                                                            {
                                                                                <div class="d-flex align-items-center gap-2 text-muted py-3 rl-timeline-fade">
                                                                                    <span class="spinner-border spinner-border-sm text-primary"
                                                                                          role="status"
                                                                                          aria-hidden="true"></span>
                                                                                    <span>Loading repair history...</span>
                                                                                </div>
                                                                            }
                                                                            else if (_isFetchingComplaintHistory)
                                                                            {
                                                                                <div style="min-height: 48px;"></div>
                                                                            }
                                                                            else if (!string.IsNullOrWhiteSpace(_complaintHistoryError))
                                                                            {
                                                                                <div class="alert alert-danger mb-0 rl-timeline-fade">
                                                                                    @_complaintHistoryError
                                                                                </div>
                                                                            }
                                                                            else if (_selectedComplaintHistory.Count == 0)
                                                                            {
                                                                                <p class="text-muted mb-0 rl-timeline-fade">
                                                                                    No status history has been recorded for this complaint yet.
                                                                                </p>
                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="pt-2 rl-timeline-fade"
                                                                                     @key="_selectedHistoryComplaintId">

                                                                                    @foreach (var item in _selectedComplaintHistory
                                                                                        .OrderBy(h => h.ChangedAt)
                                                                                        .ThenBy(h => h.HistoryId))
                                                                                    {
                                                                                        <div class="d-flex gap-3 py-3 border-bottom">

                                                                                            <div class="rounded-circle bg-primary flex-shrink-0"
                                                                                                 style="width: 10px; height: 10px; margin-top: 7px;">
                                                                                            </div>

                                                                                            <div>
                                                                                                <div class="fw-semibold">
                                                                                                    @GetHistoryTitle(item.NewStatus)
                                                                                                </div>

                                                                                                <div class="text-muted small">
                                                                                                    @item.ChangedByName
                                                                                                    (@item.ChangedByRole)
                                                                                                </div>

                                                                                                <div class="text-muted small">
                                                                                                    @item.ChangedAt.ToLocalTime().ToString(
                                                                                                        "dd MMM yyyy, hh:mm tt")
                                                                                                </div>
                                                                                            </div>

                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        }

                    </section>
                }

                @if (authState.User.IsInRole("Technician"))
                {
                    <section class="rl-dashboard-section">
                        <div class="card rl-dashboard-card">
                            <div class="card-header rl-dashboard-card-header">
                                <h2>Technician dashboard</h2>
                            </div>
                            <div class="card-body rl-dashboard-card-body">
                                <p class="rl-dashboard-card-text">
                                    Review the repair requests assigned to your account.
                                </p>

                                <div class="rl-dashboard-actions">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Href="/technician/complaints">
                                        View assigned repairs
                                    </MudButton>
                                </div>
                            </div>
                        </div>
                    </section>
                }

                @if (authState.User.IsInRole("Admin"))
                {
                    <section class="rl-dashboard-section">
                        <div class="card rl-dashboard-card">
                            <div class="card-header rl-dashboard-card-header">
                                <h2>Admin dashboard</h2>
                            </div>
                            <div class="card-body rl-dashboard-card-body">
                                <p class="rl-dashboard-card-text">
                                    Manage users and oversee repair assignments.
                                </p>

                                <div class="rl-dashboard-actions">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Href="/admin/users">
                                        Manage user accounts
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Href="/admin/assignments">
                                        Assign complaints
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Href="/admin/system-logs">
                                        View system logs
                                    </MudButton>
                                </div>
                            </div>
                        </div>
                    </section>
                }

            </Authorized>

            <NotAuthorized>
                <div class="rl-session-expired">
                    <div class="rl-session-expired-card">
                        <h2>Session expired</h2>

                        <p>
                            Your session has ended because you signed out
                            or your session expired.
                        </p>

                        <a href="/login"
                           target="_top"
                           class="btn btn-primary">
                            Sign in again
                        </a>
                    </div>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private CreateComplaintApiRequest _newComplaint = new();

    private bool _showComplaintForm;

    private bool _isSubmittingComplaint;

    private string? _complaintFormError;

    private string? _complaintSuccessMessage;

    private IReadOnlyList<CustomerComplaintApiDto> _customerComplaints
        = Array.Empty<CustomerComplaintApiDto>();

    private bool _isLoadingComplaints = true;

    private string? _complaintsError;

    private int? _selectedHistoryComplaintId;

    private string? _selectedHistoryTicketNumber;

    private bool _isFetchingComplaintHistory;

    private bool _showComplaintHistorySpinner;

    private string? _complaintHistoryError;

    private IReadOnlyList<CustomerComplaintHistoryApiDto>
        _selectedComplaintHistory = [];

    private readonly Dictionary<int, IReadOnlyList<CustomerComplaintHistoryApiDto>>
        _complaintHistoryCache = new();

    private int _complaintHistoryRequestVersion;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.IsInRole("Customer"))
        {
            await LoadCustomerComplaintsAsync(
                authState.User);
        }

        _isLoadingComplaints = false;
    }

    private async Task LoadCustomerComplaintsAsync(
        System.Security.Claims.ClaimsPrincipal user)
    {
        try
        {
            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _complaintsError =
                    "Your session is unavailable. Please sign in again.";
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _complaintsError =
                    "Your API access token has expired. Please sign in again.";
                return;
            }

            var client =
                HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                "api/Complaints");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _complaintsError =
                    "Your API session has expired. Please sign in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _complaintsError =
                    "You do not have permission to view these complaints.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _complaintsError =
                    $"Could not load repair requests. API returned " +
                    $"{(int)response.StatusCode}.";
                return;
            }

            var complaints =
                await response.Content.ReadFromJsonAsync<
                    List<CustomerComplaintApiDto>>();

            if (complaints is not null)
            {
                _customerComplaints = complaints;
                _complaintHistoryCache.Clear();
            }
        }
        catch (HttpRequestException)
        {
            _complaintsError =
                "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _complaintsError =
                "The request timed out. Please try again.";
        }
        catch (JsonException)
        {
            _complaintsError =
                "The API returned an invalid response.";
        }
    }

    private async Task ToggleComplaintHistoryAsync(
        CustomerComplaintApiDto complaint)
    {
        if (_selectedHistoryComplaintId == complaint.ComplaintId)
        {
            CloseComplaintHistory();
            return;
        }

        await LoadComplaintHistoryAsync(complaint);
    }

    private async Task LoadComplaintHistoryAsync(
        CustomerComplaintApiDto complaint)
    {
        var requestVersion = ++_complaintHistoryRequestVersion;

        _selectedHistoryComplaintId = complaint.ComplaintId;
        _selectedHistoryTicketNumber = complaint.TicketNumber;
        _complaintHistoryError = null;

        if (_complaintHistoryCache.TryGetValue(
                complaint.ComplaintId,
                out var cachedHistory))
        {
            _isFetchingComplaintHistory = false;
            _showComplaintHistorySpinner = false;
            _selectedComplaintHistory = cachedHistory;
            return;
        }

        _isFetchingComplaintHistory = true;
        _showComplaintHistorySpinner = false;
        _selectedComplaintHistory = [];

        using var spinnerDelayCts = new CancellationTokenSource();
        _ = RevealHistorySpinnerAfterDelayAsync(
            requestVersion,
            spinnerDelayCts.Token);

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            if (requestVersion != _complaintHistoryRequestVersion)
                return;

            var sessionId = authState.User
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _complaintHistoryError =
                    "Your session is unavailable. Please sign in again.";
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _complaintHistoryError =
                    "Your API token has expired. Please sign in again.";
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/Complaints/{complaint.ComplaintId}/history");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (requestVersion != _complaintHistoryRequestVersion)
                return;

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _complaintHistoryError =
                    "Your session has expired. Please sign in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _complaintHistoryError =
                    "You are not authorized to view this history.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _complaintHistoryError =
                    "This complaint could not be found.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _complaintHistoryError =
                    $"Could not load history. HTTP {(int)response.StatusCode}.";
                return;
            }

            var history =
                await response.Content.ReadFromJsonAsync<
                    List<CustomerComplaintHistoryApiDto>>() ?? [];

            if (requestVersion != _complaintHistoryRequestVersion)
                return;

            _complaintHistoryCache[complaint.ComplaintId] = history;
            _selectedComplaintHistory = history;
        }
        catch (HttpRequestException)
        {
            if (requestVersion == _complaintHistoryRequestVersion)
            {
                _complaintHistoryError =
                    "Could not connect to the API.";
            }
        }
        catch (TaskCanceledException)
        {
            if (requestVersion == _complaintHistoryRequestVersion)
            {
                _complaintHistoryError =
                    "The history request timed out.";
            }
        }
        catch (JsonException)
        {
            if (requestVersion == _complaintHistoryRequestVersion)
            {
                _complaintHistoryError =
                    "The API returned an invalid history response.";
            }
        }
        finally
        {
            spinnerDelayCts.Cancel();

            if (requestVersion == _complaintHistoryRequestVersion)
            {
                _isFetchingComplaintHistory = false;
                _showComplaintHistorySpinner = false;
            }
        }
    }

    private async Task RevealHistorySpinnerAfterDelayAsync(
        int requestVersion,
        CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(150, cancellationToken);

            if (!cancellationToken.IsCancellationRequested &&
                requestVersion == _complaintHistoryRequestVersion &&
                _isFetchingComplaintHistory)
            {
                _showComplaintHistorySpinner = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Response arrived within 150ms; skip spinner entirely.
        }
    }

    private void OpenComplaintForm()
    {
        _newComplaint = new();
        _complaintFormError = null;
        _complaintSuccessMessage = null;
        _showComplaintForm = true;
    }

    private void CancelComplaintForm()
    {
        _showComplaintForm = false;
        _newComplaint = new();
        _complaintFormError = null;
    }

    private async Task SubmitComplaintAsync()
    {
        if (_isSubmittingComplaint)
            return;

        _isSubmittingComplaint = true;
        _complaintFormError = null;
        _complaintSuccessMessage = null;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _complaintFormError =
                    "Your session is unavailable. Please sign in again.";
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _complaintFormError =
                    "Your API access token has expired. Please sign in again.";
                return;
            }

            var client =
                HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                "api/Complaints");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            request.Content = JsonContent.Create(_newComplaint);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _complaintFormError =
                    "Your API session has expired. Please sign in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _complaintFormError =
                    "You do not have permission to submit complaints.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                _complaintFormError =
                    "The API rejected the complaint details. Please check your entries.";
                return;
            }

            if (response.StatusCode != HttpStatusCode.Created)
            {
                _complaintFormError =
                    $"Could not submit the complaint. API returned " +
                    $"{(int)response.StatusCode}.";
                return;
            }

            // A 201 response means the API successfully created the complaint.
            CustomerComplaintApiDto? createdComplaint = null;

            try
            {
                createdComplaint =
                    await response.Content.ReadFromJsonAsync<CustomerComplaintApiDto>();
            }
            catch (JsonException)
            {
                // Creation succeeded; continue with the dashboard refresh.
            }

            _newComplaint = new();
            _showComplaintForm = false;

            _complaintSuccessMessage = createdComplaint is not null
                ? $"Repair request {createdComplaint.TicketNumber} submitted successfully."
                : "Your repair request was submitted successfully.";

            // Retrieve the updated list from the API.
            _complaintsError = null;

            await LoadCustomerComplaintsAsync(user);
        }
        catch (HttpRequestException)
        {
            _complaintFormError =
                "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _complaintFormError =
                "The request timed out. Please try again.";
        }
        finally
        {
            _isSubmittingComplaint = false;
        }
    }

    private static string GetDeviceName(
        CustomerComplaintApiDto complaint)
    {
        return $"{complaint.DeviceBrand} {complaint.DeviceModel}".Trim();
    }

    private static string FormatStatus(string status)
    {
        return status switch
        {
            "InDiagnosis" => "In Diagnosis",
            "QuotePending" => "Quote Pending",
            "InRepair" => "In Repair",
            _ => status
        };
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Submitted" => "bg-secondary",
            "Assigned" => "bg-primary",
            "InDiagnosis" => "bg-info text-dark",
            "QuotePending" => "bg-warning text-dark",
            "Approved" => "bg-success",
            "InRepair" => "bg-primary",
            "Completed" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static string GetHistoryTitle(string status)
    {
        return status switch
        {
            "Submitted" => "Complaint submitted",
            "Assigned" => "Technician assigned",
            "InDiagnosis" => "Diagnosis started",
            "QuotePending" => "Quotation submitted",
            "Approved" => "Quotation approved",
            "InRepair" => "Repair started",
            "Completed" => "Repair completed",
            "Cancelled" => "Complaint cancelled",
            _ => $"Status changed to {status}"
        };
    }

    private void CloseComplaintHistory()
    {
        _complaintHistoryRequestVersion++;
        _selectedHistoryComplaintId = null;
        _isFetchingComplaintHistory = false;
        _showComplaintHistorySpinner = false;
    }
}