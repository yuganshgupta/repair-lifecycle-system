@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using RepairSystem.Web.Features.Admin.Contracts
@using RepairSystem.Web.Features.Admin.Components

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IApiTokenSessionStore TokenStore

<PageTitle>Manage Users</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div>
            <h1 class="mb-1">Manage Users</h1>
            <p class="text-muted mb-0">
                View and manage registered system accounts.
            </p>
        </div>

        <div class="d-flex gap-2">

            <button type="button"
                    class="btn btn-primary"
                    @onclick="OpenCreateForm">
                <span class="me-1" aria-hidden="true">+</span>
                New User
            </button>

            <a href="/dashboard" class="btn btn-outline-secondary">
                Back to dashboard
            </a>

        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")"
             role="alert">
            @_message
        </div>
    }

    <section class="card mb-4">

        <div class="card-header bg-white py-3 d-flex
            justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-1">User Accounts</h2>
                <p class="text-muted small mb-0">
                    View registered users and their account status.
                </p>
            </div>

            <span class="badge bg-secondary">
                @_users.Count users
            </span>
        </div>

        @if (_isLoadingUsers)
        {
            <div class="card-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading user accounts...
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_usersError))
        {
            <div class="card-body">
                <div class="alert alert-danger mb-0">
                    @_usersError

                    <button type="button"
                            class="btn btn-sm btn-outline-danger ms-2"
                            @onclick="LoadUsersAsync">
                        Retry
                    </button>
                </div>
            </div>
        }
        else if (_users.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h3 class="h6">No users found</h3>
                <p class="text-muted mb-0">
                    Newly created accounts will appear here.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>User Name</th>
                            <th>Email Address</th>
                            <th>Role</th>
                            <th>Account Status</th>
                            <th>Created On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in _users)
                        {
                            <tr>
                                <td>
                                    <strong>@user.FullName</strong>
                                </td>

                                <td>@user.Email</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @user.Role
                                    </span>
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex flex-wrap justify-content-end gap-2">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary"
                                                title="Edit user"
                                                aria-label="@($"Edit {user.FullName}")"
                                                disabled="@_isSubmitting"
                                                @onclick="() => OpenEditForm(user)">
                                            <span aria-hidden="true">✎</span>
                                            Edit
                                        </button>

                                        @if (user.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Deactivate user"
                                                    aria-label="@($"Deactivate {user.FullName}")"
                                                    disabled="@_isSubmitting"
                                                    @onclick="() => RequestStatusConfirmation(user, false)">
                                                <span aria-hidden="true">⊖</span>
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success"
                                                    title="Activate user"
                                                    aria-label="@($"Activate {user.FullName}")"
                                                    disabled="@_isSubmitting"
                                                    @onclick="() => RequestStatusConfirmation(user, true)">
                                                <span aria-hidden="true">✓</span>
                                                Activate
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </section>

    @if (_showUserForm)
    {
        <UserForm @key="_userForm"
                  Model="@_userForm"
                  IsCreate="@(!_isEditMode)"
                  IsSubmitting="@_isSubmitting"
                  OnValidSubmit="RequestUserConfirmation"
                  OnCancel="CancelUserForm" />
    }

    <ConfirmationDialog IsVisible="@_showConfirmation"
                        Title="@ConfirmationTitle"
                        Message="@ConfirmationMessage"
                        ConfirmButtonText="@ConfirmationButtonText"
                        ConfirmButtonClass="@ConfirmationButtonClass"
                        IsBusy="@_isSubmitting"
                        OnConfirm="ConfirmUserSaveAsync"
                        OnCancel="CancelConfirmation" />
</div>

@code {
    private UserFormModel _userForm = new()
    {
        IsCreate = true
    };

    private bool _showUserForm;

    private bool _showConfirmation;

    private bool _isEditMode;

    private int? _editingUserId;

    private bool _isStatusChangeMode;

    private int? _statusTargetUserId;

    private string _statusTargetName = string.Empty;

    private bool _requestedActiveStatus;

    private bool _isSubmitting;
    private bool _isError;
    private string? _message;
    private IReadOnlyList<AdminUserApiDto> _users =
        Array.Empty<AdminUserApiDto>();
    private bool _isLoadingUsers = true;
    private string? _usersError;

    private string ConfirmationTitle =>
        _isStatusChangeMode
            ? (_requestedActiveStatus
                ? "Confirm account activation"
                : "Confirm account deactivation")
            : _isEditMode
                ? "Confirm user changes"
                : "Confirm user creation";

    private string ConfirmationButtonText =>
        _isStatusChangeMode
            ? (_requestedActiveStatus ? "Activate Account" : "Deactivate Account")
            : _isEditMode
                ? "Save Changes"
                : "Create User";

    private string ConfirmationButtonClass =>
        _isStatusChangeMode
            ? (_requestedActiveStatus ? "btn-success" : "btn-danger")
            : "btn-primary";

    private string ConfirmationMessage =>
        _isStatusChangeMode
            ? (_requestedActiveStatus
                ? $"Reactivate {_statusTargetName}'s account? They will be able to sign in again."
                : $"Deactivate {_statusTargetName}'s account? They will no longer be able to sign in. Their repair history will be preserved.")
            : _isEditMode
                ? $"Save changes to {_userForm.FullName} ({_userForm.Email})?"
                : $"Create a {_userForm.Role} account for " +
                  $"{_userForm.FullName} ({_userForm.Email})?";

    private void OpenCreateForm()
    {
        _isEditMode = false;
        _editingUserId = null;
        _isStatusChangeMode = false;

        _userForm = new UserFormModel
        {
            IsCreate = true,
            Role = "Customer"
        };

        _showUserForm = true;
        _showConfirmation = false;

        _message = null;
        _isError = false;
    }

    private void OpenEditForm(AdminUserApiDto user)
    {
        _isEditMode = true;
        _editingUserId = user.UserId;
        _isStatusChangeMode = false;

        _userForm = new UserFormModel
        {
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            Password = null,
            IsCreate = false
        };

        _showUserForm = true;
        _showConfirmation = false;

        _message = null;
        _isError = false;
    }

    private void CancelUserForm()
    {
        _showUserForm = false;
        _showConfirmation = false;

        _isEditMode = false;
        _editingUserId = null;
        _isStatusChangeMode = false;
    }

    private void RequestUserConfirmation(UserFormModel model)
    {
        _userForm = model;
        _showConfirmation = true;

        _message = null;
        _isError = false;
    }

    private void RequestStatusConfirmation(
        AdminUserApiDto user,
        bool activate)
    {
        _isStatusChangeMode = true;

        _statusTargetUserId = user.UserId;
        _statusTargetName = user.FullName;
        _requestedActiveStatus = activate;

        _showUserForm = false;
        _showConfirmation = true;

        _isEditMode = false;
        _editingUserId = null;

        _message = null;
        _isError = false;
    }

    private void CancelConfirmation()
    {
        _showConfirmation = false;

        if (_isStatusChangeMode)
        {
            _isStatusChangeMode = false;
            _statusTargetUserId = null;
            _statusTargetName = string.Empty;
        }
    }

    private async Task ConfirmUserSaveAsync()
    {
        if (_isStatusChangeMode)
        {
            await UpdateUserStatusAsync();
        }
        else if (_isEditMode)
        {
            await UpdateUserAsync();
        }
        else
        {
            await ConfirmCreateUserAsync();
        }
    }

    private async Task ConfirmCreateUserAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _message = null;
        _isError = false;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError(
                    "Only an authenticated Admin can create accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError(
                    "Your session is unavailable. Sign out and sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError(
                    "Your API token has expired. Sign out and sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            var requestBody = new CreateUserApiRequest
            {
                FullName = _userForm.FullName.Trim(),
                Email = _userForm.Email.Trim(),
                Password = _userForm.Password ?? string.Empty,
                Role = _userForm.Role
            };

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                "api/auth/users")
            {
                Content = JsonContent.Create(requestBody)
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Created)
            {
                var createdRole = _userForm.Role;

                _showConfirmation = false;
                _showUserForm = false;

                _userForm = new UserFormModel
                {
                    IsCreate = true
                };

                _message = $"{createdRole} account created successfully.";

                await LoadUsersAsync();

                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                ShowError(
                    "An account with this email already exists, " +
                    "or the requested role was rejected.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError(
                    "The API rejected your session. Sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError(
                    "The API denied this operation. Check your Admin role.");
                return;
            }

            ShowError(
                $"Could not create account. API returned " +
                $"{(int)response.StatusCode} ({response.StatusCode}).");
        }
        catch (HttpRequestException)
        {
            ShowError(
                "Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError(
                "The API request timed out. Check the API and try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateUserAsync()
    {
        if (_isSubmitting || _editingUserId is not int userId)
        {
            return;
        }

        _isSubmitting = true;
        _message = null;
        _isError = false;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError(
                    "Only an authenticated Admin can update accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError(
                    "Your session is unavailable. Sign out and sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError(
                    "Your API token has expired. Sign out and sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            var requestBody = new UpdateUserApiRequest
            {
                FullName = _userForm.FullName.Trim(),
                Email = _userForm.Email.Trim(),
                Role = _userForm.Role
            };

            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                $"api/auth/users/{userId}")
            {
                Content = JsonContent.Create(requestBody)
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                _showConfirmation = false;
                _showUserForm = false;

                _isEditMode = false;
                _editingUserId = null;

                _userForm = new UserFormModel
                {
                    IsCreate = true
                };

                _message = "User account updated successfully.";

                await LoadUsersAsync();

                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                ShowError("The user account no longer exists.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                ShowError(
                    "Another account already uses this email address.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                ShowError(
                    "The API rejected the supplied user details.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError(
                    "The API rejected your session. Sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError(
                    "The API denied this operation. An Admin role is required.");
                return;
            }

            ShowError(
                $"Could not update user. API returned " +
                $"{(int)response.StatusCode} ({response.StatusCode}).");
        }
        catch (HttpRequestException)
        {
            ShowError(
                "Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError(
                "The API request timed out. Check the API and try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateUserStatusAsync()
    {
        if (_isSubmitting || _statusTargetUserId is not int userId)
        {
            return;
        }

        _isSubmitting = true;
        _message = null;
        _isError = false;

        var requestedStatus = _requestedActiveStatus;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError("Only an authenticated Admin can manage user accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError("Your session is unavailable. Please sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError("Your API token has expired. Please sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Patch,
                $"api/auth/users/{userId}/status")
            {
                Content = JsonContent.Create(
                    new UpdateUserStatusApiRequest
                    {
                        IsActive = requestedStatus
                    })
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                _showConfirmation = false;
                _isStatusChangeMode = false;
                _statusTargetUserId = null;
                _statusTargetName = string.Empty;

                _message = requestedStatus
                    ? "User account activated successfully."
                    : "User account deactivated successfully.";

                await LoadUsersAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                var responseBody =
                    await response.Content.ReadAsStringAsync();

                try
                {
                    using var document = JsonDocument.Parse(responseBody);

                    if (document.RootElement.TryGetProperty(
                            "message", out var messageElement))
                    {
                        ShowError(
                            messageElement.GetString() ??
                            "This account status change is not allowed.");
                        return;
                    }
                }
                catch (JsonException)
                {
                    // Use the fallback message below.
                }

                ShowError(
                    "This account status change is not allowed.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                ShowError("The user account could not be found.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError("Your API session has expired. Please sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError("Only Admins can change account status.");
                return;
            }

            ShowError(
                $"Could not change account status. API returned " +
                $"{(int)response.StatusCode}.");
        }
        catch (HttpRequestException)
        {
            ShowError("Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError("The API request timed out. Please try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ShowError(string message)
    {
        _message = message;
        _isError = true;

        _showConfirmation = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;
        _usersError = null;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                _usersError =
                    "Only an authenticated Admin can view user accounts.";
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _usersError =
                    "Your session is unavailable. Please sign in again.";
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _usersError =
                    "Your API token has expired. Please sign in again.";
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                "api/Auth/users");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _usersError =
                    "Your API session has expired. Please sign in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _usersError =
                    "The API denied access. An Admin role is required.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _usersError =
                    $"Could not retrieve users. API returned " +
                    $"{(int)response.StatusCode}.";
                return;
            }

            var users =
                await response.Content.ReadFromJsonAsync<
                    List<AdminUserApiDto>>();

            if (users is not null)
            {
                _users = users;
            }
        }
        catch (HttpRequestException)
        {
            _usersError =
                "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _usersError =
                "The request timed out. Please try again.";
        }
        catch (JsonException)
        {
            _usersError =
                "The API returned an invalid users response.";
        }
        finally
        {
            _isLoadingUsers = false;
        }
    }
}