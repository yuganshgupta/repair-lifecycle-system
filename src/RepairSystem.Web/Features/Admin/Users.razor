@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using RepairSystem.Web.Features.Admin.Contracts
@using RepairSystem.Web.Features.Admin.Components

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IApiTokenSessionStore TokenStore
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudProviders />
<PageTitle>Manage Users</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">

        <div>
            <h1 class="mb-1">Manage Users</h1>
            <p class="text-muted mb-0">
                View and manage registered system accounts.
            </p>
        </div>

        <div class="d-flex gap-2">

            <button type="button"
                    class="btn btn-primary"
                    @onclick="OpenCreateForm">
                <span class="me-1" aria-hidden="true">+</span>
                New User
            </button>

            <a href="/dashboard" class="btn btn-outline-secondary">
                Back to dashboard
            </a>

        </div>

    </div>

    <section class="card mb-4">

        <div class="card-header bg-white py-3 d-flex
            justify-content-between align-items-center">
            <div>
                <h2 class="h5 mb-1">User Accounts</h2>
                <p class="text-muted small mb-0">
                    View registered users and their account status.
                </p>
            </div>

            <span class="badge bg-secondary">
                @_users.Count users
            </span>
        </div>

        @if (_isLoadingUsers)
        {
            <div class="card-body text-center p-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>

                <p class="text-muted mt-3 mb-0">
                    Loading user accounts...
                </p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_usersError))
        {
            <div class="card-body">
                <div class="alert alert-danger mb-0">
                    @_usersError

                    <button type="button"
                            class="btn btn-sm btn-outline-danger ms-2"
                            @onclick="LoadUsersAsync">
                        Retry
                    </button>
                </div>
            </div>
        }
        else if (_users.Count == 0)
        {
            <div class="card-body text-center py-5">
                <h3 class="h6">No users found</h3>
                <p class="text-muted mb-0">
                    Newly created accounts will appear here.
                </p>
            </div>
        }
        else
        {

            <MudTable T="AdminUserApiDto"
                      Items="@_users"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      Breakpoint="Breakpoint.Sm">

                <HeaderContent>
                    <MudTh>User Name</MudTh>
                    <MudTh>Email Address</MudTh>
                    <MudTh>Role</MudTh>
                    <MudTh>Account Status</MudTh>
                    <MudTh>Created On</MudTh>
                    <MudTh Class="text-end">Actions</MudTh>
                </HeaderContent>

                <RowTemplate Context="user">

                    <MudTd DataLabel="User Name">
                        <strong>@user.FullName</strong>
                    </MudTd>

                    <MudTd DataLabel="Email Address">
                        @user.Email
                    </MudTd>

                    <MudTd DataLabel="Role">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Default"
                                 Variant="Variant.Outlined">
                            @user.Role
                        </MudChip>
                    </MudTd>

                    <MudTd DataLabel="Account Status">
                        @if (user.IsActive)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Success">
                                Active
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Error">
                                Inactive
                            </MudChip>
                        }
                    </MudTd>

                    <MudTd DataLabel="Created On">
                        @(user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                    </MudTd>

                    <MudTd DataLabel="Actions" Class="text-end">
                        <div class="d-inline-flex flex-wrap justify-content-end gap-2">

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       title="Edit user"
                                       aria-label="@($"Edit {user.FullName}")"
                                       Disabled="@_isSubmitting"
                                       OnClick="@(() => OpenEditForm(user))">
                                Edit
                            </MudButton>

                            @if (user.IsActive)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           title="Deactivate user"
                                           aria-label="@($"Deactivate {user.FullName}")"
                                           Disabled="@_isSubmitting"
                                           OnClick="@(() => RequestStatusConfirmation(user, false))">
                                    Deactivate
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           title="Activate user"
                                           aria-label="@($"Activate {user.FullName}")"
                                           Disabled="@_isSubmitting"
                                           OnClick="@(() => RequestStatusConfirmation(user, true))">
                                    Activate
                                </MudButton>
                            }

                        </div>
                    </MudTd>

                </RowTemplate>

            </MudTable>

        }

    </section>

</div>

@code {
    private UserFormModel _userForm = new()
    {
        IsCreate = true
    };

    private bool _isEditMode;

    private int? _editingUserId;

    private bool _isStatusChangeMode;

    private int? _statusTargetUserId;

    private string _statusTargetName = string.Empty;

    private bool _requestedActiveStatus;

    private bool _userOperationSucceeded;

    private bool _isSubmitting;
    private IReadOnlyList<AdminUserApiDto> _users =
        Array.Empty<AdminUserApiDto>();
    private bool _isLoadingUsers = true;
    private string? _usersError;

    private string ConfirmationTitle =>
        _isStatusChangeMode
            ? (_requestedActiveStatus
                ? "Confirm account activation"
                : "Confirm account deactivation")
            : _isEditMode
                ? "Confirm user changes"
                : "Confirm user creation";

    private string ConfirmationButtonText =>
        _isStatusChangeMode
            ? (_requestedActiveStatus ? "Activate Account" : "Deactivate Account")
            : _isEditMode
                ? "Save Changes"
                : "Create User";

    private Color ConfirmationButtonColor =>
        _isStatusChangeMode
            ? (_requestedActiveStatus ? Color.Success : Color.Error)
            : Color.Primary;

    private string ConfirmationMessage =>
        _isStatusChangeMode
            ? (_requestedActiveStatus
                ? $"Reactivate {_statusTargetName}'s account? They will be able to sign in again."
                : $"Deactivate {_statusTargetName}'s account? They will no longer be able to sign in. Their repair history will be preserved.")
            : _isEditMode
                ? $"Save changes to {_userForm.FullName} ({_userForm.Email})?"
                : $"Create a {_userForm.Role} account for " +
                  $"{_userForm.FullName} ({_userForm.Email})?";

    private Task OpenCreateForm()
    {
        _isEditMode = false;
        _editingUserId = null;
        _isStatusChangeMode = false;

        _userForm = new UserFormModel
        {
            IsCreate = true,
            Role = "Customer"
        };

        return ShowUserFormDialogAsync();
    }

    private Task OpenEditForm(AdminUserApiDto user)
    {
        _isEditMode = true;
        _editingUserId = user.UserId;
        _isStatusChangeMode = false;

        _userForm = new UserFormModel
        {
            FullName = user.FullName,
            Email = user.Email,
            Role = user.Role,
            Password = null,
            IsCreate = false
        };

        return ShowUserFormDialogAsync();
    }

    private async Task ShowUserFormDialogAsync()
    {
        var isCreate = !_isEditMode;

        var parameters = new DialogParameters<UserFormDialog>
        {
            { x => x.Model, _userForm },
            { x => x.IsCreate, isCreate }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<UserFormDialog>(
            isCreate ? "Create User" : "Edit User",
            parameters,
            options);

        var result = await dialog.Result;

        if (result is null ||
            result.Canceled ||
            result.Data is not UserFormModel submittedModel)
        {
            _isEditMode = false;
            _editingUserId = null;
            return;
        }

        _userForm = submittedModel;
        _isStatusChangeMode = false;

        await ShowConfirmationDialogAsync();
    }

    private async Task ShowConfirmationDialogAsync()
    {
        _userOperationSucceeded = false;

        var parameters = new DialogParameters<ConfirmationDialog>
        {
            { x => x.Message, ConfirmationMessage },
            { x => x.ConfirmButtonText, ConfirmationButtonText },
            { x => x.ConfirmButtonColor, ConfirmationButtonColor },
            {
                x => x.OnConfirm,
                EventCallback.Factory.Create(this, ConfirmUserSaveAsync)
            }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false
        };

        var dialogReference =
            await DialogService.ShowAsync<ConfirmationDialog>(
                ConfirmationTitle,
                parameters,
                options);

        var result = await dialogReference.Result;

        if (_isStatusChangeMode)
        {
            CancelConfirmation();
            return;
        }

        if (result is not null &&
            !result.Canceled &&
            _userOperationSucceeded)
        {
            // Operation succeeded. Clear the form state.
            _userForm = new UserFormModel
            {
                IsCreate = true
            };

            _isEditMode = false;
            _editingUserId = null;

            return;
        }

        // Confirmation was cancelled or the API operation failed.
        // Reopen the form with its previous values.
        await ShowUserFormDialogAsync();
    }

    private async Task RequestStatusConfirmation(
        AdminUserApiDto user,
        bool activate)
    {
        _isStatusChangeMode = true;

        _statusTargetUserId = user.UserId;
        _statusTargetName = user.FullName;
        _requestedActiveStatus = activate;

        _isEditMode = false;
        _editingUserId = null;

        await ShowConfirmationDialogAsync();
    }

    private void CancelConfirmation()
    {
        _isStatusChangeMode = false;
        _statusTargetUserId = null;
        _statusTargetName = string.Empty;
    }

    private async Task ConfirmUserSaveAsync()
    {
        if (_isStatusChangeMode)
        {
            await UpdateUserStatusAsync();
        }
        else if (_isEditMode)
        {
            await UpdateUserAsync();
        }
        else
        {
            await ConfirmCreateUserAsync();
        }
    }

    private async Task ConfirmCreateUserAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError(
                    "Only an authenticated Admin can create accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError(
                    "Your session is unavailable. Sign out and sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError(
                    "Your API token has expired. Sign out and sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            var requestBody = new CreateUserApiRequest
            {
                FullName = _userForm.FullName.Trim(),
                Email = _userForm.Email.Trim(),
                Password = _userForm.Password ?? string.Empty,
                Role = _userForm.Role
            };

            using var request = new HttpRequestMessage(
                HttpMethod.Post,
                "api/auth/users")
            {
                Content = JsonContent.Create(requestBody)
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Created)
            {
                _userOperationSucceeded = true;

                Snackbar.Add(
                    $"{_userForm.Role} account created successfully.",
                    Severity.Success);

                await LoadUsersAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                ShowError(
                    "An account with this email already exists, " +
                    "or the requested role was rejected.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError(
                    "The API rejected your session. Sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError(
                    "The API denied this operation. Check your Admin role.");
                return;
            }

            ShowError(
                $"Could not create account. API returned " +
                $"{(int)response.StatusCode} ({response.StatusCode}).");
        }
        catch (HttpRequestException)
        {
            ShowError(
                "Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError(
                "The API request timed out. Check the API and try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateUserAsync()
    {
        if (_isSubmitting || _editingUserId is not int userId)
        {
            return;
        }

        _isSubmitting = true;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError(
                    "Only an authenticated Admin can update accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError(
                    "Your session is unavailable. Sign out and sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError(
                    "Your API token has expired. Sign out and sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            var requestBody = new UpdateUserApiRequest
            {
                FullName = _userForm.FullName.Trim(),
                Email = _userForm.Email.Trim(),
                Role = _userForm.Role
            };

            using var request = new HttpRequestMessage(
                HttpMethod.Put,
                $"api/auth/users/{userId}")
            {
                Content = JsonContent.Create(requestBody)
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                _userOperationSucceeded = true;

                Snackbar.Add(
                    "User account updated successfully.",
                    Severity.Success);

                await LoadUsersAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                ShowError("The user account no longer exists.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                ShowError(
                    "Another account already uses this email address.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                ShowError(
                    "The API rejected the supplied user details.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError(
                    "The API rejected your session. Sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError(
                    "The API denied this operation. An Admin role is required.");
                return;
            }

            ShowError(
                $"Could not update user. API returned " +
                $"{(int)response.StatusCode} ({response.StatusCode}).");
        }
        catch (HttpRequestException)
        {
            ShowError(
                "Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError(
                "The API request timed out. Check the API and try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task UpdateUserStatusAsync()
    {
        if (_isSubmitting || _statusTargetUserId is not int userId)
        {
            return;
        }

        _isSubmitting = true;

        var requestedStatus = _requestedActiveStatus;

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                ShowError("Only an authenticated Admin can manage user accounts.");
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                ShowError("Your session is unavailable. Please sign in again.");
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                ShowError("Your API token has expired. Please sign in again.");
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Patch,
                $"api/auth/users/{userId}/status")
            {
                Content = JsonContent.Create(
                    new UpdateUserStatusApiRequest
                    {
                        IsActive = requestedStatus
                    })
            };

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.NoContent)
            {
                _isStatusChangeMode = false;
                _statusTargetUserId = null;
                _statusTargetName = string.Empty;

                Snackbar.Add(
                    requestedStatus
                        ? "User account activated successfully."
                        : "User account deactivated successfully.",
                    Severity.Success);

                await LoadUsersAsync();
                return;
            }

            if (response.StatusCode == HttpStatusCode.Conflict)
            {
                var responseBody =
                    await response.Content.ReadAsStringAsync();

                try
                {
                    using var document = JsonDocument.Parse(responseBody);

                    if (document.RootElement.TryGetProperty(
                            "message", out var messageElement))
                    {
                        ShowError(
                            messageElement.GetString() ??
                            "This account status change is not allowed.");
                        return;
                    }
                }
                catch (JsonException)
                {
                    // Use the fallback message below.
                }

                ShowError(
                    "This account status change is not allowed.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                ShowError("The user account could not be found.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                ShowError("Your API session has expired. Please sign in again.");
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                ShowError("Only Admins can change account status.");
                return;
            }

            ShowError(
                $"Could not change account status. API returned " +
                $"{(int)response.StatusCode}.");
        }
        catch (HttpRequestException)
        {
            ShowError("Could not connect to the API. Make sure it is running.");
        }
        catch (TaskCanceledException)
        {
            ShowError("The API request timed out. Please try again.");
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ShowError(string message)
    {
        Snackbar.Add(message, Severity.Error);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        _isLoadingUsers = true;
        _usersError = null;

        try
        {
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                _usersError =
                    "Only an authenticated Admin can view user accounts.";
                return;
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _usersError =
                    "Your session is unavailable. Please sign in again.";
                return;
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _usersError =
                    "Your API token has expired. Please sign in again.";
                return;
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                "api/Auth/users");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(request);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _usersError =
                    "Your API session has expired. Please sign in again.";
                return;
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _usersError =
                    "The API denied access. An Admin role is required.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _usersError =
                    $"Could not retrieve users. API returned " +
                    $"{(int)response.StatusCode}.";
                return;
            }

            var users =
                await response.Content.ReadFromJsonAsync<
                    List<AdminUserApiDto>>();

            if (users is not null)
            {
                _users = users;
            }
        }
        catch (HttpRequestException)
        {
            _usersError =
                "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _usersError =
                "The request timed out. Please try again.";
        }
        catch (JsonException)
        {
            _usersError =
                "The API returned an invalid users response.";
        }
        finally
        {
            _isLoadingUsers = false;
        }
    }
}