@using Microsoft.AspNetCore.Components.Forms
@using RepairSystem.Web.Features.Admin.Contracts
@using System.Collections.Generic

<section class="card mb-4">

    <div class="card-header bg-white py-3">
        <h2 class="h5 mb-0">
            @(IsCreate ? "Create User" : "Edit User")
        </h2>
    </div>

    <div class="card-body">

        <EditForm Model="@Model"
                  OnValidSubmit="HandleValidSubmit">

            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row g-3">

                <div class="col-md-6">
                    <MudTextField T="string"
                                  Label="Full Name"
                                  @bind-Value="Model.FullName"
                                  For="@(() => Model.FullName)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  UserAttributes="@FullNameAttributes" />
                </div>

                <div class="col-md-6">
                    <MudTextField T="string"
                                  Label="Email Address"
                                  @bind-Value="Model.Email"
                                  For="@(() => Model.Email)"
                                  InputType="InputType.Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  FullWidth="true"
                                  UserAttributes="@EmailAttributes" />
                </div>

                @if (IsCreate)
                {
                    <div class="col-md-6">
                        <MudTextField T="string"
                                      Label="Temporary Password"
                                      @bind-Value="Model.Password"
                                      For="@(() => Model.Password)"
                                      InputType="InputType.Password"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true"
                                      UserAttributes="@PasswordAttributes" />
                    </div>
                }

                <div class="col-md-6">
                    <MudSelect T="string"
                               Label="Role"
                               @bind-Value="Model.Role"
                               For="@(() => Model.Role)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               FullWidth="true">

                        <MudSelectItem T="string" Value="@("Customer")">
                            Customer
                        </MudSelectItem>

                        <MudSelectItem T="string" Value="@("Technician")">
                            Technician
                        </MudSelectItem>

                        <MudSelectItem T="string" Value="@("Admin")">
                            Admin
                        </MudSelectItem>

                    </MudSelect>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2">

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="@IsSubmitting">

                    @if (IsSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true"
                                             Size="Size.Small"
                                             Class="me-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        @SubmitButtonText
                    }

                </MudButton>

                <MudButton ButtonType="ButtonType.Button"
                           Variant="Variant.Outlined"
                           Color="Color.Default"
                           Disabled="@IsSubmitting"
                           OnClick="@OnCancel">
                    Cancel
                </MudButton>

            </div>

        </EditForm>

    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public UserFormModel Model { get; set; } = new();

    [Parameter]
    public bool IsCreate { get; set; } = true;

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback<UserFormModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string SubmitButtonText =>
        IsCreate ? "Create User" : "Save Changes";

    private static readonly Dictionary<string, object> FullNameAttributes =
        new()
        {
            ["autocomplete"] = "name"
        };

    private static readonly Dictionary<string, object> EmailAttributes =
        new()
        {
            ["autocomplete"] = "email"
        };

    private static readonly Dictionary<string, object> PasswordAttributes =
        new()
        {
            ["autocomplete"] = "new-password"
        };

    protected override void OnParametersSet()
    {
        Model.IsCreate = IsCreate;
    }

    private Task HandleValidSubmit()
    {
        return OnValidSubmit.InvokeAsync(Model);
    }
}
