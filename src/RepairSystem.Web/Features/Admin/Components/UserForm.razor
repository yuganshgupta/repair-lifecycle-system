@using Microsoft.AspNetCore.Components.Forms
@using RepairSystem.Web.Features.Admin.Contracts
@using System.Collections.Generic

<EditForm Model="@Model"
          OnValidSubmit="HandleValidSubmit">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <MudGrid Spacing="3">

        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Full Name"
                          @bind-Value="Model.FullName"
                          For="@(() => Model.FullName)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          UserAttributes="@FullNameAttributes" />
        </MudItem>

        <MudItem xs="12">
            <MudTextField T="string"
                          Label="Email Address"
                          @bind-Value="Model.Email"
                          For="@(() => Model.Email)"
                          InputType="InputType.Email"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          UserAttributes="@EmailAttributes" />
        </MudItem>

        @if (IsCreate)
        {
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="Temporary Password"
                              @bind-Value="Model.Password"
                              For="@(() => Model.Password)"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true"
                              UserAttributes="@PasswordAttributes" />
            </MudItem>
        }

        <MudItem xs="12">
            <MudSelect T="string"
                       Label="Role"
                       @bind-Value="Model.Role"
                       For="@(() => Model.Role)"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       FullWidth="true">

                <MudSelectItem T="string" Value="@("Customer")">
                    Customer
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("Technician")">
                    Technician
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("Admin")">
                    Admin
                </MudSelectItem>

            </MudSelect>
        </MudItem>

    </MudGrid>

    <div class="d-flex justify-content-end gap-2 mt-4">

        <MudButton ButtonType="ButtonType.Button"
                   Variant="Variant.Outlined"
                   Color="Color.Default"
                   Disabled="@IsSubmitting"
                   OnClick="@OnCancel">
            Cancel
        </MudButton>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@IsSubmitting">

            @SubmitButtonText

        </MudButton>

    </div>

</EditForm>

@code {
    [Parameter, EditorRequired]
    public UserFormModel Model { get; set; } = new();

    [Parameter]
    public bool IsCreate { get; set; } = true;

    [Parameter]
    public bool IsSubmitting { get; set; }

    [Parameter]
    public EventCallback<UserFormModel> OnValidSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private string SubmitButtonText =>
        IsCreate ? "Continue" : "Review Changes";

    private static readonly Dictionary<string, object> FullNameAttributes =
        new()
        {
            ["autocomplete"] = "name"
        };

    private static readonly Dictionary<string, object> EmailAttributes =
        new()
        {
            ["autocomplete"] = "email"
        };

    private static readonly Dictionary<string, object> PasswordAttributes =
        new()
        {
            ["autocomplete"] = "new-password"
        };

    protected override void OnParametersSet()
    {
        Model.IsCreate = IsCreate;
    }

    private Task HandleValidSubmit()
    {
        return OnValidSubmit.InvokeAsync(Model);
    }
}
