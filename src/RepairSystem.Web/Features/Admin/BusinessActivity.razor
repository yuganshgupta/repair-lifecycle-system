@page "/admin/business-activity"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer

@using System.Globalization
@using System.Net
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.Json
@using RepairSystem.Web.Features.Admin.Contracts
@using RepairSystem.Web.Services.Authentication

@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IApiTokenSessionStore TokenStore

<MudProviders />

<PageTitle>Business Activity History</PageTitle>

<div class="container-fluid mt-4 mb-5 px-3">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="mb-1">Business Activity History</h1>
            <p class="text-muted mb-0">
                Track important customer, technician and administrative actions.
            </p>
        </div>

        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAsync">
                Refresh
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Href="/dashboard">
                Dashboard
            </MudButton>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_pageError))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">
            @_pageError
        </MudAlert>
    }

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mb-4">

        <MudText Typo="Typo.h6" Class="mb-3">
            Search and filters
        </MudText>

        <MudGrid Spacing="3">

            <MudItem xs="12" md="4">
                <MudTextField T="string"
                              @bind-Value="_searchTerm"
                              Label="Search activity"
                              Placeholder="Ticket, name, title or description"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudSelect T="string"
                           @bind-Value="_eventType"
                           Label="Event type"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true">
                    @foreach (var option in _eventTypes)
                    {
                        <MudSelectItem T="string" Value="@option.Value">
                            @option.Label
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudTextField T="string"
                              @bind-Value="_actorUserId"
                              Label="Actor user ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="2">
                <MudTextField T="string"
                              @bind-Value="_complaintId"
                              Label="Complaint ID"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="From date"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="To date"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="d-flex gap-2 align-center mt-1">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="ApplyFiltersAsync">
                        Apply filters
                    </MudButton>

                    <MudButton Variant="Variant.Text"
                               OnClick="ClearFiltersAsync">
                        Clear filters
                    </MudButton>
                </div>
            </MudItem>

        </MudGrid>

    </MudPaper>

    <MudPaper Outlined="true" Elevation="0" Class="pa-3">

        <div class="mb-3">
            <MudText Typo="Typo.h6">Activity records</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                @_totalCount.ToString("N0") matching events
            </MudText>
        </div>

        <MudTable T="BusinessActivityApiDto"
                  @ref="_table"
                  ServerData="LoadServerData"
                  RowsPerPage="25"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Bordered="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Sm">

            <HeaderContent>
                <MudTh>Timestamp</MudTh>
                <MudTh>Activity</MudTh>
                <MudTh>Actor</MudTh>
                <MudTh>Customer</MudTh>
                <MudTh>Ticket</MudTh>
                <MudTh>Details</MudTh>
            </HeaderContent>

            <RowTemplate Context="activity">

                <MudTd DataLabel="Timestamp">
                    <span class="text-nowrap">
                        @activity.OccurredAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                    </span>
                </MudTd>

                <MudTd DataLabel="Activity">
                    <strong>@activity.Title</strong>
                    <div class="text-muted small">
                        @activity.EventType
                    </div>
                </MudTd>

                <MudTd DataLabel="Actor">
                    <strong>@activity.ActorName</strong>
                    <div class="text-muted small">
                        @activity.ActorRole
                        @if (activity.ActorUserId.HasValue)
                        {
                            <span> · #@activity.ActorUserId</span>
                        }
                    </div>
                </MudTd>

                <MudTd DataLabel="Customer">
                    @(activity.CustomerName ?? "—")
                </MudTd>

                <MudTd DataLabel="Ticket">
                    @if (!string.IsNullOrWhiteSpace(activity.TicketNumber))
                    {
                        <strong>@activity.TicketNumber</strong>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>

                <MudTd DataLabel="Details">
                    <details>
                        <summary class="text-primary"
                                 style="cursor:pointer;">
                            Inspect
                        </summary>

                        <div class="mt-2"
                             style="min-width:220px; max-width:400px; overflow-wrap:anywhere;">
                            <p>@activity.Description</p>

                            @if (activity.TargetUserId.HasValue)
                            {
                                <p>
                                    Target:
                                    @(activity.TargetUserName ?? "User")
                                    (#@activity.TargetUserId)
                                </p>
                            }

                            @if (!string.IsNullOrWhiteSpace(activity.DetailsJson))
                            {
                                <pre style="white-space:pre-wrap; overflow-wrap:anywhere;">@activity.DetailsJson</pre>
                            }
                        </div>
                    </details>
                </MudTd>

            </RowTemplate>

            <NoRecordsContent>
                <div class="text-center pa-5">
                    <MudText Typo="Typo.subtitle1">
                        No matching activity records
                    </MudText>
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Try adjusting your search filters.
                    </MudText>
                </div>
            </NoRecordsContent>

            <PagerContent>
                <MudTablePager PageSizeOptions="_pageSizeOptions" />
            </PagerContent>

        </MudTable>

    </MudPaper>
</div>

@code {
    private MudTable<BusinessActivityApiDto>? _table;

    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];

    private readonly (string Value, string Label)[] _eventTypes =
    [
        ("1", "Customer registered"),
        ("2", "User account created"),
        ("3", "User details updated"),
        ("4", "User activated"),
        ("5", "User deactivated"),
        ("6", "Complaint submitted"),
        ("7", "Technician assigned"),
        ("8", "Diagnosis started"),
        ("9", "Quotation submitted"),
        ("10", "Quotation accepted"),
        ("11", "Quotation rejected"),
        ("12", "Repair started"),
        ("13", "Repair completed"),
        ("14", "Complaint cancelled")
    ];

    private string? _searchTerm;
    private string? _eventType;
    private string? _actorUserId;
    private string? _complaintId;

    private DateTime? _fromDate;
    private DateTime? _toDate;

    private string? _pageError;
    private int _totalCount;

    private async Task<TableData<BusinessActivityApiDto>> LoadServerData(
        TableState state,
        CancellationToken cancellationToken)
    {
        _pageError = null;

        if (!string.IsNullOrWhiteSpace(_actorUserId) &&
            (!int.TryParse(_actorUserId, out var actorId) ||
             actorId <= 0))
        {
            _pageError = "Actor user ID must be a positive number.";
            return EmptyTable();
        }

        if (!string.IsNullOrWhiteSpace(_complaintId) &&
            (!int.TryParse(_complaintId, out var complaintId) ||
             complaintId <= 0))
        {
            _pageError = "Complaint ID must be a positive number.";
            return EmptyTable();
        }

        if (_fromDate.HasValue &&
            _toDate.HasValue &&
            _fromDate.Value.Date > _toDate.Value.Date)
        {
            _pageError = "From date cannot be later than To date.";
            return EmptyTable();
        }

        var parameters = new List<string>();

        AddParameter(parameters, "page",
            (state.Page + 1).ToString(CultureInfo.InvariantCulture));

        AddParameter(parameters, "pageSize",
            state.PageSize.ToString(CultureInfo.InvariantCulture));

        AddParameter(parameters, "searchTerm", _searchTerm);
        AddParameter(parameters, "eventType", _eventType);
        AddParameter(parameters, "actorUserId", _actorUserId);
        AddParameter(parameters, "complaintId", _complaintId);

        if (_fromDate.HasValue)
        {
            var localStart = DateTime.SpecifyKind(
                _fromDate.Value.Date,
                DateTimeKind.Local);

            AddParameter(parameters, "fromUtc",
                localStart.ToUniversalTime().ToString(
                    "O", CultureInfo.InvariantCulture));
        }

        if (_toDate.HasValue)
        {
            // Exclusive end avoids losing late-day events.
            var localEnd = DateTime.SpecifyKind(
                _toDate.Value.Date.AddDays(1),
                DateTimeKind.Local);

            AddParameter(parameters, "toUtcExclusive",
                localEnd.ToUniversalTime().ToString(
                    "O", CultureInfo.InvariantCulture));
        }

        var queryString = string.Join("&", parameters);

        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true ||
                !user.IsInRole("Admin"))
            {
                _pageError = "Administrator access is required.";
                return EmptyTable();
            }

            var sessionId = user
                .FindFirst(WebAuthenticationDefaults.SessionIdClaimType)
                ?.Value;

            if (string.IsNullOrWhiteSpace(sessionId) ||
                !TokenStore.TryGet(sessionId, out var session) ||
                session is null)
            {
                _pageError = "Your session is unavailable. Sign in again.";
                return EmptyTable();
            }

            if (session.AccessTokenExpiresAtUtc <= DateTimeOffset.UtcNow)
            {
                _pageError = "Your API token has expired. Sign in again.";
                return EmptyTable();
            }

            var client = HttpClientFactory.CreateClient("RepairApi");

            using var request = new HttpRequestMessage(
                HttpMethod.Get,
                $"api/admin/business-activity?{queryString}");

            request.Headers.Authorization =
                new AuthenticationHeaderValue(
                    "Bearer",
                    session.AccessToken);

            using var response = await client.SendAsync(
                request,
                HttpCompletionOption.ResponseHeadersRead,
                cancellationToken);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                _pageError = "Your API session has expired.";
                return EmptyTable();
            }

            if (response.StatusCode == HttpStatusCode.Forbidden)
            {
                _pageError = "Administrator permission is required.";
                return EmptyTable();
            }

            if (!response.IsSuccessStatusCode)
            {
                _pageError =
                    $"Activity API returned {(int)response.StatusCode}.";
                return EmptyTable();
            }

            var result = await response.Content.ReadFromJsonAsync<
                PagedBusinessActivityApiResponse>(
                cancellationToken: cancellationToken);

            if (result is null)
            {
                _pageError = "The API returned an empty response.";
                return EmptyTable();
            }

            _totalCount = result.TotalCount;

            return new TableData<BusinessActivityApiDto>
            {
                Items = result.Items,
                TotalItems = result.TotalCount
            };
        }
        catch (OperationCanceledException)
            when (cancellationToken.IsCancellationRequested)
        {
            throw;
        }
        catch (HttpRequestException)
        {
            _pageError = "Could not connect to the API.";
            return EmptyTable();
        }
        catch (TaskCanceledException)
        {
            _pageError = "The API request timed out.";
            return EmptyTable();
        }
        catch (JsonException)
        {
            _pageError = "Invalid API response.";
            return EmptyTable();
        }
    }

    private TableData<BusinessActivityApiDto> EmptyTable()
    {
        _totalCount = 0;

        return new TableData<BusinessActivityApiDto>
        {
            Items = Array.Empty<BusinessActivityApiDto>(),
            TotalItems = 0
        };
    }

    private static void AddParameter(
        List<string> parameters,
        string name,
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return;

        parameters.Add(
            $"{Uri.EscapeDataString(name)}={Uri.EscapeDataString(value)}");
    }

    private async Task ApplyFiltersAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task ClearFiltersAsync()
    {
        _searchTerm = null;
        _eventType = null;
        _actorUserId = null;
        _complaintId = null;
        _fromDate = null;
        _toDate = null;

        if (_table is not null)
            await _table.ReloadServerData();
    }

    private async Task RefreshAsync()
    {
        if (_table is not null)
            await _table.ReloadServerData();
    }
}