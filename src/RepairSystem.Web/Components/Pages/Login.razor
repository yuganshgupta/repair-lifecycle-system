@page "/"
@page "/login"
@rendermode InteractiveServer
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject RepairAuthenticationStateProvider AuthStateProvider

<PageTitle>Sign In</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <h2 class="mb-2">Sign in</h2>
            <p class="text-muted mb-4">
                Sign in to your Repair Lifecycle account.
            </p>

            @if (_loginSucceeded)
            {
                <div class="alert alert-success">
                    <h5>Login successful</h5>
                    <p class="mb-0">
                        Welcome, @_fullName!
                    </p>
                    <p class="mb-0">Role: @_role</p>
                </div>
            }
            else
            {
                <EditForm Model="_model"
                          OnValidSubmit="LoginAsync"
                          FormName="LoginForm">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Email address
                        </label>
                        <InputText id="email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="username"
                                   @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">
                            Password
                        </label>
                        <InputText id="password"
                                   class="form-control"
                                   type="password"
                                   autocomplete="current-password"
                                   @bind-Value="_model.Password" />
                        <ValidationMessage For="@(() => _model.Password)" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @_errorMessage
                        </div>
                    }

                    <button type="submit"
                            class="btn btn-primary w-100"
                            disabled="@_isLoading">
                        @(_isLoading ? "Signing in..." : "Sign in")
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private readonly LoginForm _model = new();

    private bool _isLoading;
    private bool _loginSucceeded;
    private string? _errorMessage;
    private string? _fullName;
    private string? _role;

    // Keep the token on the server, not in browser local storage.
    private string? _accessToken;

    private async Task LoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("RepairApi");

            // Send the credentials to our API for verification.
            using var response = await client.PostAsJsonAsync(
                "api/auth/login",
                new
                {
                    email = _model.Email.Trim(),
                    password = _model.Password
                });

            if (!response.IsSuccessStatusCode)
            {
                _errorMessage =
                    response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                        ? "Invalid email or password."
                        : $"Login failed (HTTP {(int)response.StatusCode}).";

                return;
            }

            using var result =
                await response.Content.ReadFromJsonAsync<JsonDocument>();

            if (result is null)
            {
                _errorMessage = "The API returned an invalid response.";
                return;
            }

            
            var root = result.RootElement;
            var token = root.GetProperty("accessToken").GetString();

            if (string.IsNullOrWhiteSpace(token))
            {
                _errorMessage = "The API did not return an access token.";
                return;
            }

            var user = root.GetProperty("user");

            var userId = user.GetProperty("userId").GetInt32();
            var fullName = user.GetProperty("fullName").GetString();
            var email = user.GetProperty("email").GetString();
            var role = user.GetProperty("role").GetString();

            if (userId <= 0 ||
                string.IsNullOrWhiteSpace(fullName) ||
                string.IsNullOrWhiteSpace(email) ||
                string.IsNullOrWhiteSpace(role))
            {
                _errorMessage = "The API returned incomplete user information.";
                return;
            }

            // Keep the token on the server for subsequent API integration.
            _accessToken = token;

            // Keep the details for the existing success message.
            _fullName = fullName;
            _role = role;

            // Notify Blazor that a user has signed in.
            AuthStateProvider.SignIn(userId, fullName, email, role);

            _loginSucceeded = true;
        }


        catch (HttpRequestException)
        {
            _errorMessage =
                "Could not connect to the API. Make sure it is running.";
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "The login request timed out.";
        }
        catch (JsonException)
        {
            _errorMessage = "The API returned an unexpected response.";
        }
        catch (KeyNotFoundException)
        {
            _errorMessage = "The API response was missing required fields.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class LoginForm
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}