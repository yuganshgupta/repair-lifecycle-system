@using MudBlazor

<MudThemeProvider Theme="@_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#2563EB",
            PrimaryContrastText = "#FFFFFF",

            Secondary = "#64748B",

            Background = "#F5F8FC",
            Surface = "#FFFFFF",

            TextPrimary = "#172B4D",
            TextSecondary = "#64748B",

            AppbarBackground = "#FFFFFF",
            AppbarText = "#172B4D",

            DrawerBackground = "#FFFFFF",
            DrawerText = "#172B4D",

            LinesDefault = "#DCE5F0",
            LinesInputs = "#DCE5F0",

            TableLines = "#DCE5F0",
            TableStriped = "#F8FAFC",
            TableHover = "#EFF6FF",

            Info = "#2563EB",
            Success = "#15803D",
            Warning = "#B45309",
            Error = "#B91C1C"
        },

        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "6px"
        },

        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Roboto", "Arial", "sans-serif"],
                FontSize = ".9375rem",
                FontWeight = "400"
            }
        }
    };
}
